rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validModule(module) {
      return module in [
        'profile', 'agenda', 'tasks', 'context', 'finance', 'gym', 'study',
        'streaming', 'jobs', 'resale', 'ideas', 'calendar', 'goals', 'notes',
        'checkout'
      ];
    }

    // Single Source of Truth for CryptoEnvelope in Firestore
    function isValidCryptoEnvelope(envelope) {
      return envelope is map
        && envelope.keys().hasOnly(['cryptoVersion', 'algorithm', 'iv', 'ciphertext', 'aad', 'createdAt'])
        && envelope.cryptoVersion is int
        && envelope.cryptoVersion == 1
        && envelope.algorithm == 'AES-GCM-256'
        && envelope.iv is string
        && envelope.ciphertext is string
        && (!('aad' in envelope) || envelope.aad is string)
        && envelope.createdAt is string;
    }

    // Validation for WrappedKeyEnvelope stored in users/{userId}/lifeosAccount/keyEnvelope
    function isValidWrappedKeyEnvelope(envelope, userId) {
      return envelope is map
        && envelope.keys().hasOnly(['keyFormatVersion', 'cryptoVersion', 'algorithm', 'wrappedMdek', 'kdf', 'aad', 'createdAt'])
        && envelope.keyFormatVersion is int
        && envelope.keyFormatVersion == 1
        && envelope.cryptoVersion is int
        && envelope.cryptoVersion == 1
        && envelope.algorithm == 'AES-GCM-256'
        && envelope.wrappedMdek is map
        && envelope.wrappedMdek.keys().hasOnly(['iv', 'ciphertext'])
        && envelope.wrappedMdek.iv is string
        && envelope.wrappedMdek.ciphertext is string
        && envelope.kdf is map
        && envelope.kdf.keys().hasOnly(['algorithm', 'salt', 'info'])
        && envelope.kdf.algorithm == 'HKDF-SHA-256'
        && envelope.kdf.salt is string
        && envelope.kdf.info is string
        && envelope.aad is string
        // Strict context & user binding: envelope cannot be bound to a different userId
        && envelope.aad == 'keyFormatVersion:1|userId:' + userId
        && envelope.createdAt is string;
    }

    function hasCapability(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/lifeosAccount/capability);
    }

    function getCapability(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/lifeosAccount/capability).data;
    }

    // Determines if a module must be written encrypted:
    // - If account capability is 'encrypted'
    // - Or if account capability is 'mixed' and module is listed in capability.encryptedModules
    // - Or if the existing remote module document was already encrypted (prevents silent downgrade)
    function moduleRequiresEncryption(userId, module) {
      let cap = hasCapability(userId) ? getCapability(userId) : null;
      let hasEncryptedList = cap != null && ('encryptedModules' in cap) && (cap.encryptedModules is list);
      let isCapEncrypted = cap != null && ('encryptionState' in cap) && cap.encryptionState == 'encrypted';
      let isCapMixed = cap != null && ('encryptionState' in cap) && cap.encryptionState == 'mixed' && hasEncryptedList && module in cap.encryptedModules;
      let moduleDocPath = /databases/$(database)/documents/users/$(userId)/lifeosModules/$(module);
      let existingModuleDoc = exists(moduleDocPath) ? get(moduleDocPath).data : null;
      let existingIsEncrypted = existingModuleDoc != null && ('isEncrypted' in existingModuleDoc) && existingModuleDoc.isEncrypted == true;

      return isCapEncrypted || isCapMixed || existingIsEncrypted;
    }

    // Determines if legacy write (v1, plaintext) is permitted for the account:
    // Permitted ONLY if capability does not exist, or capability encryptionState is 'plaintext'
    function legacyWritesPermitted(userId) {
      return !hasCapability(userId)
        || ('encryptionState' in getCapability(userId) && getCapability(userId).encryptionState == 'plaintext');
    }

    function validSyncPayload(userId, module) {
      let isMustEncrypt = moduleRequiresEncryption(userId, module);
      let isReqEncrypted = ('isEncrypted' in request.resource.data) && request.resource.data.isEncrypted == true;

      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'syncProtocolVersion', 'isEncrypted', 'module', 'data',
          'revision', 'parentRevision', 'deviceId', 'clientUpdatedAt', 'updatedAt',
          'commercialProtocolVersion'
        ])
        && request.resource.data.schemaVersion is int
        && request.resource.data.module == module
        && request.resource.data.revision is string
        && request.resource.data.deviceId is string
        && request.resource.data.clientUpdatedAt is int
        && (!('isEncrypted' in request.resource.data) || request.resource.data.isEncrypted is bool)
        && (!('syncProtocolVersion' in request.resource.data) || request.resource.data.syncProtocolVersion is int)
        && (module in ['resale', 'finance'] || !('commercialProtocolVersion' in request.resource.data))
        // If module requires encryption, request MUST be encrypted
        && (!isMustEncrypt || isReqEncrypted)
        // If unencrypted, legacy writes must be permitted
        && (isReqEncrypted || legacyWritesPermitted(userId))
        // If encrypted, payload must be a valid CryptoEnvelope with protocol version >= 2
        && (!isReqEncrypted || (
          ('syncProtocolVersion' in request.resource.data)
          && request.resource.data.syncProtocolVersion >= 2
          && isValidCryptoEnvelope(request.resource.data.data)
        ));
    }

    function hasCommercialProtocol(payload) {
      return ('commercialProtocolVersion' in payload)
        && payload.commercialProtocolVersion is int
        && payload.commercialProtocolVersion >= 1;
    }

    function resaleProtocolVersion(payload) {
      return ('syncProtocolVersion' in payload) ? payload.syncProtocolVersion : 1;
    }

    function validResaleProtocolWrite() {
      let version = resaleProtocolVersion(request.resource.data);
      return version is int && version >= 1;
    }

    function preservesResaleProtocol() {
      let previous = resaleProtocolVersion(resource.data);
      let next = resaleProtocolVersion(request.resource.data);
      return previous is int && previous >= 1 && next is int && next >= previous;
    }

    function hasVisibleCommercial(payload) {
      return (!('isEncrypted' in payload) || payload.isEncrypted != true)
        && payload.data is map
        && ('resale' in payload.data)
        && payload.data.resale is map
        && ('commercial' in payload.data.resale);
    }

    function commercialPublicationEnabled() {
      let capabilityPath = /databases/$(database)/documents/systemCapabilities/commercial;
      return exists(capabilityPath)
        && get(capabilityPath).data.keys().hasOnly([
          'enabled', 'commercialProtocolVersion', 'minimumSyncProtocolVersion'
        ])
        && get(capabilityPath).data.keys().hasAll([
          'enabled', 'commercialProtocolVersion', 'minimumSyncProtocolVersion'
        ])
        && get(capabilityPath).data.enabled == true
        && get(capabilityPath).data.commercialProtocolVersion == 1
        && get(capabilityPath).data.minimumSyncProtocolVersion == 3;
    }

    function commercialWriteAuthorized(payload) {
      let marked = hasCommercialProtocol(payload);
      let visible = hasVisibleCommercial(payload);
      return (!marked && !visible) || commercialPublicationEnabled();
    }

    function validResaleCommercialWrite() {
      let payload = request.resource.data;
      let marked = hasCommercialProtocol(payload);
      let visible = hasVisibleCommercial(payload);
      return (!('commercialProtocolVersion' in payload) || marked)
        && (!visible || marked)
        && commercialWriteAuthorized(payload)
        && (!marked || (
          ('syncProtocolVersion' in payload)
          && payload.syncProtocolVersion is int
          && payload.syncProtocolVersion >= 3
          && (visible || (('isEncrypted' in payload) && payload.isEncrypted == true))
        ));
    }

    function preservesResaleCommercial() {
      let previous = resource.data;
      let next = request.resource.data;
      return (!('commercialProtocolVersion' in previous) || (
          hasCommercialProtocol(next)
          && hasCommercialProtocol(previous)
          && next.commercialProtocolVersion >= previous.commercialProtocolVersion
        ))
        && (!hasVisibleCommercial(previous) || (
          hasVisibleCommercial(next)
          || (hasCommercialProtocol(next) && ('isEncrypted' in next) && next.isEncrypted == true)
        ));
    }

    function userHasCommercialResale(userId) {
      let resalePath = /databases/$(database)/documents/users/$(userId)/lifeosModules/resale;
      return (exists(resalePath) && (hasCommercialProtocol(get(resalePath).data) || hasVisibleCommercial(get(resalePath).data)))
        || (existsAfter(resalePath) && (hasCommercialProtocol(getAfter(resalePath).data) || hasVisibleCommercial(getAfter(resalePath).data)));
    }

    function financeProtocolVersion(payload) {
      return ('syncProtocolVersion' in payload) ? payload.syncProtocolVersion : 1;
    }

    function preservesFinanceProtocol() {
      let previous = financeProtocolVersion(resource.data);
      let next = financeProtocolVersion(request.resource.data);
      return previous is int && previous >= 1 && next is int && next >= previous;
    }

    function validFinanceCommercialWrite(userId) {
      let payload = request.resource.data;
      let isUpdate = resource != null;
      let protected = isUpdate && userHasCommercialResale(userId);
      let marked = hasCommercialProtocol(payload);
      return (!protected && !marked) || (
        marked
        && commercialWriteAuthorized(payload)
        && ('syncProtocolVersion' in payload)
        && payload.syncProtocolVersion is int
        && payload.syncProtocolVersion >= 3
        && ('isEncrypted' in payload)
        && payload.isEncrypted == true
      );
    }

    function preservesFinanceCommercial() {
      let previous = resource.data;
      let next = request.resource.data;
      return (!('commercialProtocolVersion' in previous) || (
        hasCommercialProtocol(next)
        && hasCommercialProtocol(previous)
        && next.commercialProtocolVersion >= previous.commercialProtocolVersion
      ));
    }

    // Clients may read the activation state but cannot create or change it.
    // Trusted administration operates through a privileged server context.
    match /systemCapabilities/{capabilityId} {
      allow get: if request.auth != null && capabilityId == 'commercial';
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Account Sync Capability & Cloud Wrapped Key Envelope
    match /users/{userId}/lifeosAccount/{documentId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && (
        (documentId == 'capability'
          && request.resource.data.keys().hasOnly([
            'version', 'minimumSyncProtocolVersion', 'encryptionState', 'encryptedModules', 'updatedAt'
          ])
          && request.resource.data.version is int
          && request.resource.data.minimumSyncProtocolVersion is int
          && request.resource.data.encryptionState in ['plaintext', 'mixed', 'encrypted']
          && (!('encryptedModules' in request.resource.data) || request.resource.data.encryptedModules is list)
          && request.resource.data.updatedAt is string)
        ||
        (documentId == 'keyEnvelope'
          && isValidWrappedKeyEnvelope(request.resource.data, userId))
      );
      allow delete: if false;
    }

    // Lectura temporal para migrar instalaciones que usaban el documento único v1.
    // Una vez activado E2EE (mixed o encrypted), no se permiten escrituras al estado global v1.
    // Purga permitida únicamente cuando la cuenta ha culminado la migración E2EE ('encrypted').
    match /users/{userId}/lifeos/{documentId} {
      allow read: if isOwner(userId) && documentId == 'state';
      allow create, update: if isOwner(userId)
        && documentId == 'state'
        && legacyWritesPermitted(userId)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'state', 'deviceId', 'updatedAt'])
        && request.resource.data.schemaVersion is int
        && request.resource.data.state is map
        && request.resource.data.deviceId is string;
      allow delete: if isOwner(userId)
        && documentId == 'state'
        && hasCapability(userId)
        && getCapability(userId).encryptionState == 'encrypted';
    }

    match /users/{userId}/lifeosModules/{module} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && validModule(module);
      allow create: if isOwner(userId)
        && validModule(module)
        && validSyncPayload(userId, module)
        && (module != 'resale' || (validResaleProtocolWrite() && validResaleCommercialWrite()))
        && (module != 'resale' || (
          ('parentRevision' in request.resource.data)
          && request.resource.data.parentRevision == null
        ))
        && (module != 'finance' || validFinanceCommercialWrite(userId))
        && (module != 'finance' || !userHasCommercialResale(userId) || (
          ('parentRevision' in request.resource.data)
          && request.resource.data.parentRevision == null
        ));
      allow update: if isOwner(userId)
        && validModule(module)
        && validSyncPayload(userId, module)
        && (module != 'resale' || (validResaleProtocolWrite() && preservesResaleProtocol()
          && validResaleCommercialWrite() && preservesResaleCommercial()))
        && (module != 'resale' || (
          ('parentRevision' in request.resource.data)
          && request.resource.data.parentRevision is string
          && ('revision' in resource.data)
          && resource.data.revision is string
          && request.resource.data.parentRevision == resource.data.revision
        ))
        && (module != 'finance' || (preservesFinanceProtocol() && validFinanceCommercialWrite(userId)
          && preservesFinanceCommercial()))
        && (module != 'finance' || !userHasCommercialResale(userId) || (
          ('parentRevision' in request.resource.data)
          && request.resource.data.parentRevision is string
          && ('revision' in resource.data)
          && resource.data.revision is string
          && request.resource.data.parentRevision == resource.data.revision
        ));
      allow delete: if false;
    }

    match /users/{userId}/lifeosRevisions/{revisionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validModule(request.resource.data.module)
        && validSyncPayload(userId, request.resource.data.module)
        && (request.resource.data.module != 'resale' || (validResaleProtocolWrite() && validResaleCommercialWrite()))
        && (request.resource.data.module != 'finance' || validFinanceCommercialWrite(userId))
        && request.resource.data.revision == revisionId;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
      // Permite purga de revisiones heredadas en texto plano únicamente cuando la cuenta está 'encrypted'
      // y la revisión existente no estaba cifrada (evita purgar revisiones cifradas legítimas)
      allow delete: if isOwner(userId)
        && hasCapability(userId)
        && ('encryptionState' in getCapability(userId))
        && getCapability(userId).encryptionState == 'encrypted'
        && (!('isEncrypted' in resource.data) || resource.data.isEncrypted != true || !('syncProtocolVersion' in resource.data) || resource.data.syncProtocolVersion < 2);
    }
  }
}
