{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "appAssociation": "NONE",
    "rewrites": [
      { "source": "/.well-known/assetlinks.json", "destination": "/.well-known/assetlinks.json" },
      { "source": "/robots.txt", "destination": "/robots.txt" },
      { "source": "/privacidad.html", "destination": "/privacidad.html" },
      { "source": "/eliminar-cuenta.html", "destination": "/eliminar-cuenta.html" },
      { "source": "/creditos.html", "destination": "/creditos.html" },
      { "regex": ".*", "destination": "/index.html" }
    ],
    "headers": [
      {
        "regex": ".*",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
          { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval'; script-src-elem 'self' https://apis.google.com/js/api.js https://apis.google.com/_/scs/abc-static/_/js/; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://lh3.googleusercontent.com https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://lifeosanywhere.firebaseapp.com https://lifeosanywhere.web.app; frame-src 'self' https://lifeosanywhere.firebaseapp.com https://accounts.google.com https://apis.google.com; worker-src 'self' blob:; manifest-src 'self'"
          }
        ]
      },
      {
        "regex": "^[/\\\\]\\.well-known[/\\\\].*",
        "headers": [
          { "key": "Content-Type", "value": "application/json; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      },
      {
        "regex": "^[/\\\\](sw\\.js|registerSW\\.js|manifest\\.webmanifest)$",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "regex": "^[/\\\\]workbox-.*\\.js$",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "regex": "^[/\\\\]assets[/\\\\].*",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 }
  }
}
